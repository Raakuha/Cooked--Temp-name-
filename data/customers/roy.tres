}, {
"mode": "bubble",
"speaker": "Roy",
"speaker_type": "customer",
"text": "Sepertinya sudah hampir 5 bulan aku tidak lewat jalan sini"
}, {
"mode": "bubble",
"speaker": "Roy",
"speaker_type": "customer",
"text": "Dulu aku cukup sering kesini karna sedang antar barang dan kebetulan melewati jalan ini"
}, {
"mode": "bubble",
"speaker": "Roy",
"speaker_type": "customer",
"text": "Walaupun begitu sepertinya yang sekarang beda adalah kokinya ya?"
}, {
"mode": "bubble",
"speaker": "MC",
"speaker_type": "mc",
"text": ". . ."
}, {
"mode": "bubble",
"speaker": "Roy",
"speaker_type": "customer",
"text": "Sayang juga, padahal orang tua itu cukup asik"
}, {
"mode": "bubble",
"speaker": "Roy",
"speaker_type": "customer",
"text": "Tapi yasudahlah"
}, {
"mode": "bubble",
"speaker": "Roy",
"speaker_type": "customer",
"text": "Aku pesan Steak, Salad, dan Air Mineral"
}, {
"mode": "bubble",
"speaker": "MC",
"speaker_type": "mc",
"text": "Baik mohon ditunggu . . ."
